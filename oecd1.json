{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "France Adult Unemployment Rate",
  "data": {
    "url": "https://raw.githubusercontent.com/miaemad/miaemad.github.io/refs/heads/main/oecd.csv"
  },
  "width": 600,
  "height": 400,
  "title": {
    "text": "France Adult Unemployment Rate (25+ years)",
    "subtitle": "Source: OECD, 2024",
    "fontSize": 16
  },
  "transform": [
    {"calculate": "toDate(datum.TIME_PERIOD)", "as": "date"},
    {"calculate": "toNumber(datum.OBS_VALUE)", "as": "value"}
  ],
  "layer": [
    {
      "mark": {"type": "line", "color": "#f39b04", "strokeWidth": 3},
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Month",
          "axis": {"format": "%b %Y", "labelAngle": -45, "grid": false}
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Unemployment Rate (%)",
          "scale": {"domain": [5.5, 6.5], "nice": false},
          "axis": {"format": ".1f"}
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "color": "#f39b04"
      },
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"field": "value", "type": "quantitative"},
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Unemployment Rate",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {}
}