{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Lebanese Diaspora Distribution",
    "fontSize": 18,
    "subtitleFontSize": 13
  },
  "width": 400,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/miaemad/miaemad.github.io/refs/heads/main/custom.geo.json",
    "format": {"type": "json", "property": "features"}
  },
  "projection": {"type": "naturalEarth1"},
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "fill": "#e8e8e8",
        "stroke": "#aaaaaa",
        "strokeWidth": 0.5
      },
      "transform": [
        {"filter": "datum.properties.sov_a3 != 'ATA'"}
      ]
    },
    {
      "transform": [
        {
          "lookup": "properties.sov_a3",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/miaemad/miaemad.github.io/refs/heads/main/leb_diaspora_for_map.csv"
            },
            "key": "iso3",
            "fields": ["diaspora", "Country"]
          }
        },
        {"filter": "datum.diaspora != null"},
        {
          "calculate": "datum.diaspora >= 100000 ? 'red' : 'green'",
          "as": "color_group"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "color_group",
          "type": "nominal",
          "scale": {
            "domain": ["green", "red"],
            "range": ["#00A651", "#ED1C24"]
          },
          "legend": {
            "title": "Population Size",
            "labelExpr": "datum.value == 'green' ? '< 100,000' : '≥ 100,000'"
          }
        },
        "opacity": {
          "field": "diaspora",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "range": [0.3, 1]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Country"},
          {"field": "diaspora", "type": "quantitative", "title": "Population", "format": ",.0f"}
        ]
      }
    }
  ]
}
