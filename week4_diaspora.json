{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Lebanese diaspora by country",
  "data": {
    "url": "https://raw.githubusercontent.com/miaemad/miaemad.github.io/refs/heads/main/leb_diaspora.csv"
  },
  "mark": "bar",
  "encoding": {
    "color": {"value": "#00AA50"},
    "y": {
      "field": "Country",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "labelAngle": 0,
        "title": "Country of Destination"
      }
    },
    "x": {
      "field": "diaspora",
      "type": "quantitative",
      "axis": {
        "title": "Lebanese Population",
        "format": ",.0f",
        "grid": false
      }
    },
    "tooltip": [
      {"field": "Country", "type": "nominal", "title": "Country"},
      {"field": "diaspora", "type": "quantitative", "title": "Population", "format": ",.0f"}
    ]
  },
  "title": {
    "text": "Lebanese Population in the Diaspora",
    "subtitle": "Source: Wikipedia",
    "fontSize": 16,
    "subtitleFontSize": 12
  },
  "width": 350,
  "height": 300
}
